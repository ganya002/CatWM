<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>local.ouch</string>
    <key>CFBundleName</key><string>Ouch</string>
    <key>CFBundleExecutable</key><string>ouch</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <!-- Sparkle + Amore. Fill both from `amore setup` (see README); updates stay off until you do. -->
    <key>SUFeedURL</key><string>https://api.amore.computer/v1/apps/local.ouch/appcast.xml</string>
    <key>SUPublicEDKey</key><string>OEHHPP5gzJfph4/A3l7EpY7xTnvwUe1QRzHnpJHP8dY=</string>
    <key>SUEnableAutomaticChecks</key><true/>
    <!-- The report relay (report-relay/): files reports in Linear on its own. Takes priority over the email. -->
    <key>OuchReportURL</key><string>https://ouch-report-relay.nox-heights.workers.dev/report</string>
    <!-- Bug reports are emailed here. Linear: Settings → Teams → General → Create by email, then paste the address. -->
    <key>OuchReportEmail</key><string>ouchreports-22573d396926@intake.linear.app</string>
    <!-- ouch://report?id=… lets an agent hand a finished bug report back to the app. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>local.ouch.report</string>
            <key>CFBundleURLSchemes</key><array><string>ouch</string></array>
        </dict>
    </array>
</dict>
</plist>
